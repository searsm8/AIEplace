{
  "input": {
    "benchmark": "host/benchmarks/ispd2005/adaptec1",
    "xclbin": "bin/aieplace.hw.xclbin"
  },
  "params": {
    "partials_compute_method": "cpu",
    "density_compute_method": "cpu",
    "wirelength_method": "HPWL",
    "gamma": 4,
    "max_iterations": 600,
    "max_threads": 1,
    "init_learning_rate": 10,
    "init_global_lambda": 0.2,
    "focus_nets": [],
    "rand_focus_nets": 0,
    "rand_focus_nodes": 1,
    "min_iterations": 15,
    "hpwl_improvement_threshold": 0.01,
    "overflow_threshold": 0.05,
    "convergence_window": 5,
    "adaptation_window": 5,
    "slow_improvement_threshold": 0.02,
    "high_overflow_threshold": 0.1,
    "warm_start": false
  },
  "output": {
    "result_csv": "results_adaptec1.csv",
    "log_file": "logs/aieplace.log",
    "performance_jsonl": "results/aieplace_performance.jsonl",
    "visualize": true,
    "iterations_per_export": 10,
    "visualization_file": "visualizations/aieplace_visualization.png"
  }
}