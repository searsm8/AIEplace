  // =============================================================================
  // AIEPlace Configuration Options
  // =============================================================================
  // This JSON file contains the default configuration parameters for running
  // the AIEPlace placement algorithm. It includes options for method selection,
  // input file paths, and hyperparameters for the algorithm.
  // =============================================================================

  // JSON doesn't support comments, but AIEplace strips them out like a compiler
{
  "input": {
    "benchmark": "host/benchmarks/ispd2015/mgc_matrix_mult_b",
    //"benchmark": "host/benchmarks/ispd2015/mgc_fft_b",
    //"benchmark": "host/benchmarks/ispd2015/mgc_pci_bridge32_a",
    //"benchmark": "host/benchmarks/ispd2005/adaptec1",
    //"benchmark": "host/benchmarks/ispd2005/bigblue1",
    //"benchmark": "host/benchmarks/ispd2005/bigblue4",
    //"benchmark": "host/benchmarks/ispd2015/mgc_superblue11_a",
    //"benchmark": "host/benchmarks/ispd2015/mgc_superblue19",
    //"benchmark": "host/benchmarks/ispd2015/toy",

    "xclbin": "bin/aieplace.hw.xclbin"
    //"xclbin": "bin/aieplace_1cu.hw.xclbin"
    //"xclbin": "bin/aieplace.hw_emu.xclbin"
  },

  "params": {
    // Computation method selection
    "partials_compute_method": "cpu", // choose: aie, cpu, simple, hybrid, threaded
    "density_compute_method": "cpu",  // choose: aie, cpu
    "bins_per_row": 64,               // grid resolution
    "wirelength_method": "HPWL",      // choose: HPWL
    "enable_backtracking": true,      // whether to use backtracking line search for step length selection
    "enable_momentum": true,          // whether to use momentum in the optimization (Nesterov Accelerated Gradient)
    "enable_filler": true,             // whether to include filler cells in placement (XPlace always does)
    "enable_preconditioning": false,   // diagonal preconditioner: damps large macro movement (XPlace-style)
    "precond_coef_escalation": true,   // double precond_coef every 20 iters once overflow<0.3 (XPlace step_precond_coef); false = diagnostic (fixed precond_coef)
    "enable_density_clamp": true,      // clamp sub-bin cells to ~bin size in the density solve (XPlace expand_ratio); smooths the force
    "enable_pin_offsets": true,        // use per-pin offsets (bookshelf: center-relative; LEF/DEF: macro RECT) in HPWL + WL gradient; false = all pins at node origin (legacy)
    "dct_normalize": true,             // 1/N-per-DCT scaling; keeps field O(1) and lambda interpretable (essential at 1024, pure lambda-absorbed rescale)

    // Hyperparameters
    "init_gamma": 4, // plays XPlace's wa_coeff role; with gamma_bin_scaled, base_gamma = init_gamma*(bin_w+bin_h)
    "gamma_schedule": true, // if true, gamma follows overflow-driven schedule (XPlace-style); starts at 10x base_gamma
    "gamma_bin_scaled": true, // tie base_gamma to bin geometry referenced to gamma_ref_grid (grid-independent); false = legacy bare init_gamma constant
    "gamma_ref_grid": 512, // reference grid for gamma_bin_scaled: base_gamma = init_gamma*(die_w+die_h)/gamma_ref_grid; keeps absolute gamma grid-independent (512 matches the tuned suite)
    "max_threads": 1, // multithreading not yet implemented
    "init_method": "random_center", // initial placement of movable cells:
                                  //   "uniform_box"   — uniform offset in a box of half-width
                                  //                     init_spread*min(W,H) around die center.
                                  //   "random_center" — XPlace-style tight Gaussian cluster at
                                  //                     center (sigma = 0.001*die span).
                                  // A/B (adaptec1/bigblue1/fft_b/pci_bridge32_a, seed 42): quality
                                  // near-identical (uniform edged 3/4 by <2%), but we default to
                                  // random_center to stay as close to XPlace's setup as possible
                                  // while chasing its results — later tuning may depend on it.
    "init_spread": 0.25, // fraction of die width for initial node spread (uniform_box only)
    "init_step_length": 0.1, // small first step for calibration
    "density_weight_init_multiplier": 8e-5, // multiplier used to set density penalty
                                            // 0.01 means that density will contribute about 1% as much
                                            // as wirelength to the cost function at the start of placement
    "density_weight_min_step": 0.95,   // minimum step size for density_weight updates to prevent stagnation
    "density_weight_max_step": 1.05,   // maximum step size for density_weight updates to avoid divergence

    // Overflow plateau detection for emergency 2x density weight jolt
    "adaptation_window": 25,
    "slow_improvement_threshold": 0.001,
    "high_overflow_threshold": 0.7,
    // "warmup_iterations": 5, // not used currently
    "backtrack_max_tries": 10,
    "backtrack_epsilon": 1.05,

    // Convergence criteria (adaptive algorithm will stop early if met)
    "convergence_min_iterations": 50,
    "convergence_max_iterations": 1200,
    "convergence_window": 5,
    "convergence_hpwl_improvement_threshold": 0.01, // If HPWL improvement over window is below this, HPWL convergence is met.
    "convergence_overflow_threshold": 0.07, // If ratio of total overflow to total node area is below this, density convergence is met.
    "convergence_iterations": 30, // Extra iterations to run after overflow drops below threshold (XPlace uses 30)
    "maximum_utilization": 1.0  // Default target density. Overridden by benchmark's
                                // placement.constraints if present (e.g. ISPD2015).
  },

  "output": {
    "visualize": true, // if true, will export visualization images
    "iterations_per_export": 10,
    "quiet": false,    // if true, suppress all console output except errors (for DSE)
    "results_dir": "results/single_runs",
    "focus_nets": [], // focus nets are highlighted in visualization exports.
    "rand_focus_IO": 0, // not yet implemented
    "rand_focus_nets": 0,
    "rand_macro_nets": 3,
    "rand_focus_nodes": 0, // not yet implemented
    "compare_hpwl_methods": false     // one-time comparison of CPU vs simple HPWL gradients at iteration 1
  }
}