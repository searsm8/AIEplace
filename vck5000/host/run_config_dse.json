{
  "input": {
    "benchmark": "host/benchmarks/ispd2005/bigblue3",
    "xclbin": "bin/aieplace.hw.xclbin"
  },
  "params": {
    "partials_compute_method": "cpu",
    "density_compute_method": "cpu",
    "bins_per_row": 64,
    "wirelength_method": "HPWL",
    "enable_backtracking": true,
    "enable_momentum": true,
    "enable_filler": true,
    "enable_preconditioning": true,
    "gamma": 4,
    "max_threads": 1,
    "init_step_length": 0.1,
    "density_weight_init_multiplier": 8e-03,
    "density_weight_min_step": 0.95,
    "density_weight_max_step": 1.05,
    "adaptation_window": 25,
    "slow_improvement_threshold": 0.001,
    "high_overflow_threshold": 0.9,
    "warmup_iterations": 5,
    "backtrack_max_tries": 10,
    "backtrack_epsilon": 1.05,
    "convergence_min_iterations": 200,
    "convergence_max_iterations": 800,
    "convergence_window": 5,
    "convergence_hpwl_improvement_threshold": 0.01,
    "convergence_overflow_threshold": 0.07,
    "convergence_target_density": 0.9,
    "naive_decay": false,
    "decay_interval": 20,
    "decay_factor": 0.9
  },
  "output": {
    "quiet": true,
    "results_dir": "results/DSE",
    "log_file": "logs/aieplace.log",
    "performance_jsonl": "results/aieplace_performance.jsonl",
    "visualize": true,
    "iterations_per_export": 10,
    "focus_nets": [],
    "rand_focus_IO": 0,
    "rand_focus_nets": 1,
    "rand_focus_nodes": 0,
    "DSE_info": ""
  }
}