# mkcfg - convenience config for the PL-centric (pl_algo) design.
#
# Usage:   make <target> INPUT_FILE=mkcfg
#   e.g.   make pl INPUT_FILE=mkcfg TARGET=hw     (Gate 1: HLS C-synth of top.xo)
#
# The top-level Makefile includes this file BEFORE common.mk, so these
# assignments take effect over common.mk's `?=` defaults.

# Build the PL-centric placement kernel variant.
PL = pl_algo

# No pl_algo-specific AIE/HOST variants exist yet, so AIE and HOST fall through
# to the common.mk defaults (markv1). Pin them here once aie/src/pl_algo and
# host/src/pl_algo exist:
# AIE  = pl_algo
# HOST = pl_algo
